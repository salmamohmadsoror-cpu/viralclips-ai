# =========================================
# ViralClips AI — Frontend Environment Variables
# النسخة دي بتترفع على Vercel
# ⚠️ أي متغير بيبدأ بـ NEXT_PUBLIC_ بيبقى ظاهر في المتصفح (Client-side)
# متحطش هنا أي مفتاح سري (Secret Key) — دايمًا المفاتيح السرية في الباك اند بس
# =========================================

# ---- API Connection ----
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# ---- Auth (المفاتيح العامة/Publishable بس) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
# أو
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxx

# ---- Payments (المفتاح العام بس) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# ---- Analytics (اختياري) ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
