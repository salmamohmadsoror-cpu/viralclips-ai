# =========================================
# ViralClips AI — Backend Environment Variables
# النسخة دي بتترفع على Render (السيرفر / الـ Workers)
# ⚠️ متحطش الملف ده على GitHub — حطه في .gitignore
# =========================================

# ----https://your-frontend.vercel.app App Config ----
NODE_ENV=production
PORT=8080
APP_URL=https://your-frontend.vercel.app
API_URL=https://your-backend.onrender.com

# DATABASE_URL=postgresql://user:password@host:5432/dbname---- Database (Supabase / PostgreSQL) ----
DATABASE_URL=postgresql://user:password@host:5432/dbname
DIRECT_URL=postgresql://user:password@host:5432/dbname

# CLERK_SECRET_KEY=sk_live_xxxxxxxxxx
SUPABASE_URL=https://xxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxx---- Auth ----
# لو مستخدم Clerk
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
# أو لو مستخدم Supabase Auth
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxx

# REDIS_URL=redis://default:password@host:6379---- Redis (لـ BullMQ Queue) ----
REDIS_URL=redis://default:password@host:6379

# R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=viralclips-videos---- Storage (Cloudflare R2 أو AWS S3) ----
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=viralclips-videos
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# OPENAI_API_KEY=sk-
ASSEMBLYAI_API_KEY=---- Transcription ----
# اختار واحد: OpenAI Whisper أو AssemblyAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
ASSEMBLYAI_API_KEY=xxxxxxxxxxxxxxxxxxxx

#ANTHROPIC_API_KEY=sk-ant- ---- AI Analysis (اكتشاف اللحظات الفيروسية) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# STRIPE_SECRET_KEY=sk_live_---- Payments ----
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_STARTER=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxxxxxxxxxx

# ---- Video Rendering (Remotion) ----
REMOTION_LICENSE_KEY=
# لو Remotion Lambda مستخدم للريندرينج السحابي
REMOTION_AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
REMOTION_AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
REMOTION_AWS_REGION=us-east-1

# JWT_SECRET=generate-a-random-64-char-string-here---- Security ----
JWT_SECRET=generate-a-random-64-char-string-here
CORS_ORIGIN=https://your-frontend.vercel.app
